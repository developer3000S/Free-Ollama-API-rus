# ==========================================================================
# Free Ollama API Gateway — переменные окружения
# ==========================================================================
# Копируйте в .env и заполняйте:  cp .env.example .env
# Файл .env никогда не коммитится (см. .gitignore).
# Комментарии — только отдельными строками: парсер шлюза и Docker Compose
# не поддерживают комментарии в строке после значения.
#
# Подробное описание каждой группы — в README.md, раздел «Конфигурация».

# --- Основные параметры шлюза (используются сервером) ---------------------
# HTTP-порт шлюза (по умолчанию 3000)
PORT=3000
# идентификатор инстанса шлюза
GATEWAY_ID=foa-gw-main-01
# токен администратора для /admin/* (обязательно переопределите!)
FOA_ADMIN_TOKEN=
# токен аудитора для /admin/*
FOA_AUDITOR_TOKEN=

# --- Публичные порты Nginx ingress (для эндпоинта /api/endpoints) ---------
# публичный HTTP-порт (без TLS)
FOA_HTTP_PORT=8080
# публичный HTTPS-порт
FOA_HTTPS_PORT=8443

# --- CORS -----------------------------------------------------------------
# Разрешенные домены через запятую или * для всех источников.
# Пример: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://my-app.com
CORS_ALLOWED_ORIGINS=*

# --- Ключи источников discovery (см. README.md, раздел «Discovery») -------
# Используются только при вызове POST /admin/discovery/run
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=
CRIMINAL_IP_API_KEY=
GREYNOISE_API_KEY=
NATLAS_API_ENDPOINT=
NATLAS_API_KEY=
SHODAN_API_KEY=
ZOOMEYE_API_KEY=

# --- Зарезервированы под будущую реализацию (сейчас не используются) ------
FOA_OBSERVABILITY__LOG_LEVEL=
FOA_OWNER_REF=
FOA_OWNER_TOKEN=
FOA_SECURITY__CLIENT_HASH_SALT=
FOA_SERVER__HOST=
FOA_SERVER__OPENAI_API_ENABLED=
FOA_SERVER__PORT=
FOA_STORAGE__DATA_DIR=
FOA_STORAGE__MIGRATIONS=
# подключение к БД (docker-compose: postgres)
GATEWAY_DB_URL=
# секрет JWT (docker-compose: foa-jwt-dev-secret-key)
GATEWAY_JWT_SECRET=
# подключение к Redis (docker-compose: redis)
GATEWAY_REDIS_URL=
# пароль БД для контейнера postgres
POSTGRES_PASSWORD=
